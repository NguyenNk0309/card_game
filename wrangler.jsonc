{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shattered-oath-game",
  "main": "backend/realtime-worker.js",
  "compatibility_date": "2026-07-23",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/assets",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/ws",
      "/",
      "/index.html",
      "/404.html"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GameRoom"
      ]
    }
  ]
}
