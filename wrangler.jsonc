{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shattered-oath-game",
  "main": "backend/realtime-worker.js",
  "compatibility_date": "2026-07-23",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/assets",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/ws"
    ]
  }
}
